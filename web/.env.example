# Graphical Studio Web Wrapper configuration (copy to web/.env and fill in).
# Process environment variables override values set here.

# Comma-separated Host header allow-list
GS_WEB_ALLOWED_HOSTS=127.0.0.1:8040,localhost:8040

# Single allowed login identifier verified by your SSO ticket issuer
GS_WEB_ALLOWED_GITHUB_USER=your-github-username

# Dev / OAuth SSO hand-off endpoint and site identifier
GS_WEB_SSO_URL=https://auth.example.com/auth/dev-sso
GS_WEB_SSO_SITE=graphical-studio
DEV_SSO_SECRET=/path/to/dev-sso/secret

# Random secret (at least 32 chars) used to HMAC-sign session cookies
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
GS_WEB_SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional tuning
GS_WEB_SESSION_TTL=604800
GS_WEB_MAX_QUEUED=20
GS_WEB_MAX_UPLOAD_MB=15
